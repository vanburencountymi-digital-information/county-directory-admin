DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# Local SQLite is the default. Staging/prod: db-dice database `directory`.
# DATABASE_URL=postgres://directory:directory@127.0.0.1:5432/directory

# Cutover ETL only — read core.* from db-dice's `postgres` database.
# Never run Django migrations against `postgres` (Sqitch owns that).
# SOURCE_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/postgres

TENANT_ID=VBC
DIRECTORY_EDITABLE_TENANT_IDS=VBC;SJC
BASE_URL=http://localhost:8080
COOKIE_SECURE=false

# Inbound county-core Sync API (Bearer on GET /sync/*). Independent of clerk sessions.
SYNC_API_SECRET=

# Outbound Directory Admin → WordPress REST. Different secret from SYNC_API_SECRET.
# JSON map of tenant_id → full trigger-incremental-sync URL.
WP_SYNC_TRIGGER_URL_BY_TENANT={"VBC":"https://example.gov/wp-json/county/v1/trigger-incremental-sync"}
WP_SYNC_TRIGGER_SECRET=

# Magic-link email via county-core send-email relay.
WP_EMAIL_ENDPOINT=https://example.gov/wp-json/county/v1/send-email
COUNTY_SEND_EMAIL_API_KEY=
